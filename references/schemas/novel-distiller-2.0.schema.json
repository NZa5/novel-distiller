{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:novel-distiller:schema:2.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "summary",
    "characters",
    "plots",
    "relationships",
    "foreshadowing",
    "timeline",
    "style",
    "uncertainties",
    "quality"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "author",
        "input_type",
        "requested_scope",
        "actual_scope",
        "output_language",
        "requested_focus",
        "sources"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_type": {
          "enum": [
            "pasted_text",
            "txt",
            "epub",
            "attachment"
          ]
        },
        "requested_scope": {
          "enum": [
            "full_text",
            "partial_text",
            "excerpt"
          ]
        },
        "actual_scope": {
          "enum": [
            "full_text",
            "partial_text",
            "excerpt"
          ]
        },
        "output_language": {
          "type": "string",
          "minLength": 1
        },
        "requested_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "type",
              "readable",
              "chapters",
              "chunks"
            ],
            "properties": {
              "source_id": {
                "pattern": "^source-[0-9]{3,}$"
              },
              "type": {
                "enum": [
                  "pasted_text",
                  "txt",
                  "epub",
                  "attachment"
                ]
              },
              "readable": {
                "type": "boolean"
              },
              "fingerprint": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "chapters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "chapter_id",
                    "title"
                  ],
                  "properties": {
                    "chapter_id": {
                      "pattern": "^ch-[0-9]{3,}$"
                    },
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "chunks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "chunk_id",
                    "chapter_id",
                    "span"
                  ],
                  "properties": {
                    "chunk_id": {
                      "pattern": "^chunk-[0-9]{3,}$"
                    },
                    "chapter_id": {
                      "pattern": "^ch-[0-9]{3,}$"
                    },
                    "span": {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "paragraph",
                            "line_range",
                            "section",
                            "chunk",
                            "epub_cfi",
                            "other"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "plots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plot"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "foreshadowing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foreshadowing"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timeline"
      }
    },
    "style": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/style"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "status",
        "requested_scope",
        "actual_scope",
        "coverage",
        "checks",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "degraded",
            "failed"
          ]
        },
        "requested_scope": {
          "enum": [
            "full_text",
            "partial_text",
            "excerpt"
          ]
        },
        "actual_scope": {
          "enum": [
            "full_text",
            "partial_text",
            "excerpt"
          ]
        },
        "coverage": {
          "type": "object",
          "required": [
            "chunks_total",
            "chunks_processed",
            "chunks_failed",
            "chunks_unreadable",
            "percentage"
          ],
          "properties": {
            "chunks_total": {
              "type": "integer",
              "minimum": 0
            },
            "chunks_processed": {
              "type": "integer",
              "minimum": 0
            },
            "chunks_failed": {
              "type": "integer",
              "minimum": 0
            },
            "chunks_unreadable": {
              "type": "integer",
              "minimum": 0
            },
            "percentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "not_run"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "locator": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "line_range",
            "section",
            "chunk",
            "epub_cfi",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_id",
        "locator",
        "purpose"
      ],
      "properties": {
        "source_id": {
          "pattern": "^source-[0-9]{3,}$"
        },
        "chapter_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ch-[0-9]{3,}$"
        },
        "chunk_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^chunk-[0-9]{3,}$"
        },
        "locator": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "paragraph",
                "line_range",
                "section",
                "chunk",
                "epub_cfi",
                "other"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "quote": {
          "type": "string",
          "maxLength": 90
        },
        "purpose": {
          "enum": [
            "support",
            "setup",
            "payoff",
            "contradiction",
            "style_example"
          ]
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": [
        "text",
        "claim_status",
        "confidence",
        "evidence",
        "notes"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "name",
        "aliases",
        "role",
        "description",
        "goals",
        "traits",
        "arc",
        "first_appearance"
      ],
      "properties": {
        "id": {
          "pattern": "^char-[0-9]{3,}$"
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "role": {
          "enum": [
            "protagonist",
            "antagonist",
            "supporting",
            "minor",
            "unknown"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "traits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "arc": {
          "$ref": "#/$defs/assertion"
        },
        "first_appearance": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "paragraph",
                "line_range",
                "section",
                "chunk",
                "epub_cfi",
                "other"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "plot": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "type",
        "title",
        "summary",
        "participants",
        "locations",
        "causes",
        "effects",
        "turning_point",
        "resolution_status"
      ],
      "properties": {
        "id": {
          "pattern": "^plot-[0-9]{3,}$"
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "main",
            "subplot",
            "backstory"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "pattern": "^char-[0-9]{3,}$"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "turning_point": {
          "$ref": "#/$defs/assertion"
        },
        "resolution_status": {
          "enum": [
            "open",
            "resolved",
            "partial",
            "unknown"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "source_character_id",
        "target_character_id",
        "type",
        "direction",
        "description",
        "evolution",
        "strength"
      ],
      "properties": {
        "id": {
          "pattern": "^rel-[0-9]{3,}$"
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_character_id": {
          "pattern": "^char-[0-9]{3,}$"
        },
        "target_character_id": {
          "pattern": "^char-[0-9]{3,}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "directed",
            "mutual",
            "unclear"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "evolution": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "strength": {
          "enum": [
            "strong",
            "moderate",
            "weak",
            "unknown"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "foreshadowing": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "setup",
        "payoff",
        "status"
      ],
      "properties": {
        "id": {
          "pattern": "^fore-[0-9]{3,}$"
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "setup": {
          "$ref": "#/$defs/assertion"
        },
        "payoff": {
          "oneOf": [
            {
              "$ref": "#/$defs/assertion"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "planted",
            "possibly_revealed",
            "revealed",
            "unresolved",
            "not_applicable"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "revealed",
                  "possibly_revealed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payoff": {
                "$ref": "#/$defs/assertion"
              },
              "evidence": {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "payoff"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "planted",
                  "unresolved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "payoff": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "timeline": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "event",
        "participants",
        "explicit_time",
        "relative_time",
        "duration",
        "chronology_position",
        "narration_position",
        "mode"
      ],
      "properties": {
        "id": {
          "pattern": "^time-[0-9]{3,}$"
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "pattern": "^char-[0-9]{3,}$"
          }
        },
        "explicit_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "relative_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "chronology_position": {
          "type": "integer",
          "minimum": 0
        },
        "narration_position": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": [
            "linear",
            "flashback",
            "flashforward",
            "parallel",
            "unclear"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "style": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "aspect",
        "observation",
        "scope"
      ],
      "properties": {
        "id": {
          "pattern": "^style-[0-9]{3,}$"
        },
        "claim_status": {
          "enum": [
            "fact",
            "inference",
            "uncertain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "aspect": {
          "enum": [
            "viewpoint",
            "tense",
            "voice",
            "pacing",
            "dialogue",
            "sentence",
            "lexical",
            "imagery_rhetoric",
            "structure"
          ]
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "id",
        "claim_status",
        "confidence",
        "evidence",
        "notes",
        "category",
        "description",
        "related_ids",
        "alternatives"
      ],
      "properties": {
        "id": {
          "pattern": "^uncertain-[0-9]{3,}$"
        },
        "claim_status": {
          "const": "uncertain"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "related_ids": {
          "type": "array",
          "items": {
            "pattern": "^(char|plot|rel|fore|time|style)-[0-9]{3,}$"
          }
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_status": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_status": {
                "const": "uncertain"
              },
              "evidence": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
