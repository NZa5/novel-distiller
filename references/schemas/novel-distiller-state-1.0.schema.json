{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:novel-distiller:state:1.0.0",
  "type":"object",
  "required":["state_version","run","source","segmentation","checkpoint","batches","identity_registry","deduplication","progress","degradation"],
  "additionalProperties":false,
  "properties":{
    "state_version":{"const":"1.0.0"},
    "run":{"$ref":"#/$defs/run"},"source":{"$ref":"#/$defs/source"},"segmentation":{"$ref":"#/$defs/segmentation"},"checkpoint":{"$ref":"#/$defs/checkpoint"},"batches":{"type":"array","items":{"$ref":"#/$defs/batch"}},"identity_registry":{"$ref":"#/$defs/registry"},"deduplication":{"$ref":"#/$defs/dedup"},"progress":{"$ref":"#/$defs/progress"},"degradation":{"$ref":"#/$defs/degradation"}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z]+-[a-z0-9-]+$"},
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "run":{"type":"object","required":["run_id","status","state_revision"],"additionalProperties":false,"properties":{"run_id":{"type":"string","pattern":"^run-[0-9]{3,}$"},"status":{"enum":["mapped","segmented","indexing","merging","synthesizing","completed","degraded","failed","stale"]},"state_revision":{"type":"integer","minimum":0}}},
    "fingerprint":{"type":"object","required":["algorithm","value"],"additionalProperties":false,"properties":{"algorithm":{"const":"sha256"},"value":{"$ref":"#/$defs/hash"}}},
    "source":{"type":"object","required":["source_id","input_type","original_fingerprint","normalized_fingerprint","extraction_policy_version"],"additionalProperties":false,"properties":{"source_id":{"type":"string","pattern":"^source-[a-z0-9-]+$"},"input_type":{"enum":["txt","epub","attachment"]},"original_fingerprint":{"$ref":"#/$defs/fingerprint"},"normalized_fingerprint":{"$ref":"#/$defs/fingerprint"},"extraction_policy_version":{"type":"string","minLength":1,"maxLength":64}}},
    "chunk":{"type":"object","required":["id","source_order","core_span","read_span","content_fingerprint","status","retry_count"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^chunk-[a-z0-9-]+$"},"source_order":{"type":"integer","minimum":1},"core_span":{"type":"string","pattern":"^p[0-9]+-p[0-9]+$"},"read_span":{"type":"string","pattern":"^p[0-9]+-p[0-9]+$"},"content_fingerprint":{"$ref":"#/$defs/hash"},"status":{"enum":["pending","in_progress","indexed","failed","unreadable","stale"]},"retry_count":{"type":"integer","minimum":0}}},
    "segmentation":{"type":"object","required":["policy_version","fingerprint","chunks"],"additionalProperties":false,"properties":{"policy_version":{"type":"string","minLength":1},"fingerprint":{"$ref":"#/$defs/hash"},"chunks":{"type":"array","items":{"$ref":"#/$defs/chunk"}}}},
    "checkpoint":{"type":"object","required":["checkpoint_id","parent_checkpoint_id","status","committed_batch_ids","commit_frontier","state_digest"],"additionalProperties":false,"properties":{"checkpoint_id":{"type":"string","pattern":"^cp-[a-z0-9-]+$"},"parent_checkpoint_id":{"type":["string","null"]},"status":{"enum":["writing","committed"]},"committed_batch_ids":{"type":"array","items":{"type":"string"}},"commit_frontier":{"type":"integer","minimum":0},"state_digest":{"$ref":"#/$defs/hash"}}},
    "batch":{"type":"object","required":["id","chunk_ids","parent_revision","result_revision","status","idempotency_key"],"additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^batch-[a-z0-9-]+$"},"chunk_ids":{"type":"array","items":{"type":"string","pattern":"^chunk-"}},"parent_revision":{"type":"integer","minimum":0},"result_revision":{"type":"integer","minimum":0},"status":{"enum":["planned","in_progress","committed","failed"]},"idempotency_key":{"type":"string","minLength":1}}},
    "registry":{"type":"object","required":["characters","alias_assertions","redirects","tombstones"],"additionalProperties":false,"properties":{"characters":{"type":"array"},"alias_assertions":{"type":"array"},"redirects":{"type":"array"},"tombstones":{"type":"array"}}},
    "dedup":{"type":"object","required":["global_records","merge_candidates"],"additionalProperties":false,"properties":{"global_records":{"type":"array"},"merge_candidates":{"type":"array"}}},
    "progress":{"type":"object","required":["chunks_total","chunks_committed","chunks_failed","chunks_unreadable","chunks_pending","covered_core_spans","coverage_percentage","actual_scope"],"additionalProperties":false,"properties":{"chunks_total":{"type":"integer","minimum":0},"chunks_committed":{"type":"integer","minimum":0},"chunks_failed":{"type":"integer","minimum":0},"chunks_unreadable":{"type":"integer","minimum":0},"chunks_pending":{"type":"integer","minimum":0},"covered_core_spans":{"type":"array","items":{"type":"string"}},"coverage_percentage":{"type":"number","minimum":0,"maximum":100},"actual_scope":{"enum":["full_text","partial_text","excerpt"]}}},
    "degradation":{"type":"object","required":["active","reasons","skipped_dimensions"],"additionalProperties":false,"properties":{"active":{"type":"boolean"},"reasons":{"type":"array","items":{"enum":["context_limit","unreadable_source","fingerprint_unavailable","persistence_unavailable","retry_exhausted","source_changed","schema_violation"]}},"skipped_dimensions":{"type":"array","items":{"type":"string"}}}}
  }
}
